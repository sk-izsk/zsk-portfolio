{
  "name": "zsk-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "portless zsk-portfolio vite",
    "build:ai-profile": "node scripts/build-ai-profile.mjs",
    "sync:github": "node scripts/sync-github-contributions.mjs",
    "build": "node scripts/build-ai-profile.mjs && node scripts/sync-github-contributions.mjs && tsc -b && vite build",
    "lint": "oxlint .",
    "knip": "knip --config knip.config.ts --tsConfig tsconfig.app.json",
    "knip:exports": "knip --config knip.config.ts --tsConfig tsconfig.app.json --include exports",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "@types/typed.js": "^2.0.9",
    "@vanilla-extract/css": "^1.21.3",
    "ahooks": "^3.11.0",
    "dayjs": "^1.11.23",
    "ky": "^2.2.0",
    "lucide-react": "^1.66.0",
    "markdown-to-jsx": "^9.10.4",
    "mixpanel-browser": "^2.84.0",
    "react": "^19.3.1",
    "react-animated-cursor": "^2.11.2",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.3.1",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-loader-spinner": "^8.0.2",
    "react-router": "^8.5.1",
    "typed.js": "^3.0.0",
    "zsk-react-error": "^0.0.4",
    "zsk-react-i18n": "^0.0.5",
    "zsk-use-sound": "^1.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "portless": "^0.15.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.14"
}
