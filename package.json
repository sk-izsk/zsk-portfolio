{
  "name": "zsk-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "portless zsk-portfolio vite",
    "build:ai-profile": "node scripts/build-ai-profile.mjs",
    "sync:github": "node scripts/sync-github-contributions.mjs",
    "build": "node scripts/build-ai-profile.mjs && node scripts/sync-github-contributions.mjs && tsc -b && vite build",
    "lint": "oxlint .",
    "knip": "knip --config knip.config.ts --tsConfig tsconfig.app.json",
    "knip:exports": "knip --config knip.config.ts --tsConfig tsconfig.app.json --include exports",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/typed.js": "^2.0.9",
    "@vanilla-extract/css": "^1.21.2",
    "ahooks": "^3.9.7",
    "dayjs": "^1.11.21",
    "ky": "^2.0.2",
    "lucide-react": "^1.31.0",
    "mixpanel-browser": "^2.82.0",
    "react": "^19.2.8",
    "react-animated-cursor": "^2.11.2",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-loader-spinner": "^8.0.2",
    "react-router": "^8.3.0",
    "typed.js": "^3.0.0",
    "zsk-react-error": "^0.0.4",
    "zsk-react-i18n": "^0.0.5",
    "zsk-use-sound": "^1.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "portless": "^0.15.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
